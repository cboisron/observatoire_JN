# Port public de la VM. Choisir un port qui n'apparaît pas dans `ss -ltn`.
APP_PORT=8088

# Résultat des commandes `id -u` et `id -g` exécutées sur la VM.
APP_UID=1000
APP_GID=1000

# Protection légère du formulaire : 5 tentatives par IP toutes les 10 minutes.
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
